# Resonaite — root environment configuration
# ============================================
# Copy to .env and fill in your own values. Never commit the real .env.
# Server-specific settings are documented in server/.env.example.

# Server
PORT=3001
NODE_ENV=development

# Authentication
# REQUIRED in production — the server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google Cloud Storage — audio file storage
GCS_ENABLED=false
GCS_BUCKET=
GCS_PROJECT_ID=
# Path to a GCS service account JSON key (keep outside version control)
GCS_KEY_PATH=

# Gemini API — prompt processing and enhancement
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Suno AI music generation (via api.kie.ai)
SUNO_API_KEY=
SUNO_MODEL=V5

# Google Lyria 2 (legacy, kept for reference)
LYRIA_ENABLED=false
GCP_PROJECT_ID=
GCP_REGION=us-central1
